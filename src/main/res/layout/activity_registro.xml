<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:gravity="center"
    android:background="@android:color/white">


  <TextView
      android:id="@+id/tvTituloRegistro"
      android:layout_width="wrap_content"
      android:layout_height="58dp"
      android:layout_marginBottom="32dp"
      android:text="@string/title_resgistro"
      android:textSize="24sp"
      android:textStyle="bold" />

  <!-- Campo para el nombre de usuario -->
  <EditText
      android:id="@+id/etUsuarioRegistro"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginBottom="16dp"
      android:hint="@string/title_txt_usu"
      android:inputType="textPersonName" />


  <EditText
      android:id="@+id/etContrasenaRegistro"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:hint="@string/title_txt_Con"
      android:inputType="textPassword"
      android:layout_marginBottom="24dp"/>


  <Button
      android:id="@+id/btnRegistrar"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:text="@string/title_btn_Reg"/>

</LinearLayout>
